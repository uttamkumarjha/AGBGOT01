rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read access to everyone
      allow read;
      
      // Allow write access only to authenticated users
      // In a production app, you should further restrict this (e.g., size limits, file types)
      allow write: if request.auth != null;
    }
  }
}
